{
  "name": "buildwithabu",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,astro}\"",
    "typecheck": "astro check",
    "test": "vitest run",
    "deploy": "astro build && wrangler deploy",
    "indexnow": "node scripts/indexnow.mjs",
    "db:local": "wrangler d1 migrations apply buildwithabu --local",
    "db:remote": "wrangler d1 migrations apply buildwithabu --remote",
    "reel:add": "node scripts/reel-add.mjs",
    "kit:release": "node scripts/kit-release.mjs",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "astro": "^7.4.5",
    "dodopayments": "^2.61.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "standardwebhooks": "^1.1.1",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@eslint/js": "^10",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.63.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
