---
import { env } from "cloudflare:workers"
import Layout from "@/layouts/main.astro"
import { formatDuration, getReel } from "@/lib/reels"
import { breadcrumbs, videoObject } from "@/lib/schema"
import { SITE } from "@/lib/site"

export const prerender = false

const reel = Astro.params.slug ? await getReel(env, Astro.params.slug).catch(() => null) : null
if (!reel) return new Response(null, { status: 404 })
Astro.response.headers.set("cache-control", "public, max-age=60, s-maxage=600")

const path = `/reels/${reel.slug}`
const jsonLd = [
  breadcrumbs([
    { name: "Reels", path: "/reels" },
    { name: reel.title, path },
  ]),
  videoObject({
    title: reel.title,
    description: reel.description,
    poster: reel.poster,
    url: reel.video,
    page: path,
    duration: reel.duration_seconds,
    date: reel.published_at,
    transcript: reel.transcript,
  }),
]
---

<Layout title={`${reel.title} | Reel Made with Reel Studio Kit`} description={reel.description} path={path} image={reel.poster} jsonLd={jsonLd}>
  <article class="wrap watch">
    <div class="phone">
      <video src={reel.video} poster={reel.poster} controls playsinline preload="metadata" width="720" height="1280"></video>
    </div>
    <div class="info">
      <p class="kicker"><a href="/reels">// reels</a> / {formatDuration(reel.duration_seconds)}</p>
      <h1 class="h2">{reel.title}</h1>
      <p class="lede">{reel.description}</p>
      {reel.topic && <p class="mono prompt">make a reel: {reel.topic}</p>}
      <a class="btn" href="/pricing">Make reels like this · {SITE.priceLabel} once</a>
      {
        reel.transcript && (
          <section>
            <h2 class="h3">Transcript</h2>
            <p class="transcript">{reel.transcript}</p>
          </section>
        )
      }
    </div>
  </article>
</Layout>

<style>
  .watch {
    display: grid;
    grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 84px);
    padding-block: clamp(30px, 5vw, 64px) clamp(70px, 9vw, 110px);
  }
  .phone {
    position: sticky;
    top: 84px;
    align-self: start;
    padding: 9px;
    background: var(--ink);
    border-radius: 30px;
  }
  video {
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    border-radius: 22px;
    background: #000;
  }
  .info {
    display: grid;
    gap: 18px;
    justify-items: start;
    align-content: start;
  }
  .prompt {
    padding: 8px 12px;
    border-radius: 9px;
    background: #16181d;
    color: #efefe7;
    overflow-wrap: anywhere;
  }
  section {
    display: grid;
    gap: 8px;
    margin-top: 14px;
  }
  .transcript {
    max-width: 62ch;
    white-space: pre-line;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .watch {
      grid-template-columns: 1fr;
    }
    .phone {
      position: static;
      max-width: 340px;
      justify-self: center;
      width: 100%;
    }
  }
</style>
