---
import Layout from "@/layouts/main.astro"
---

<Layout title="Page not found | Abu Reel Kit" description="This page doesn't exist." path="/404" noindex>
  <div class="wrap page">
    <span class="stamp" style="--stamp:clamp(4rem,14vw,9rem)">404</span>
    <h1 class="h2">This frame didn't <span class="em">render.</span></h1>
    <a class="btn" href="/">Back to the start</a>
    <img src="/img/abu-shrug.webp" alt="" width="230" height="192" />
  </div>
</Layout>

<style>
  .page {
    display: grid;
    gap: 28px;
    justify-items: start;
    padding-block: clamp(50px, 8vw, 110px);
  }
</style>
