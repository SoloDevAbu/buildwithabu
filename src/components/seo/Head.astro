---
import { SITE } from "@/lib/site"
import { serializeJsonLd } from "@/lib/schema"

type Props = {
  title: string
  description: string
  path?: string
  image?: string
  imageWidth?: number
  imageHeight?: number
  video?: string
  videoWidth?: number
  videoHeight?: number
  type?: "website" | "article"
  noindex?: boolean
  jsonLd?: object[]
}

const {
  title,
  description,
  path,
  image = "/og/default.png",
  imageWidth = 1200,
  imageHeight = 630,
  video,
  videoWidth,
  videoHeight,
  type = "website",
  noindex = false,
  jsonLd = [],
} = Astro.props
const canonical = new URL(path ?? Astro.url.pathname, SITE.url).href.replace(/\/$/, "")
const ogImage = new URL(image, SITE.url).href
---

<title>{title}</title>
<meta name="description" content={description} />
{SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification} />}
{SITE.bingVerification && <meta name="msvalidate.01" content={SITE.bingVerification} />}
<link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
<link rel="canonical" href={canonical || SITE.url} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:site_name" content={SITE.brand} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical || SITE.url} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
{video && <meta property="og:video" content={video} />}
{video && <meta property="og:video:secure_url" content={video} />}
{video && <meta property="og:video:type" content="video/mp4" />}
{video && videoWidth && <meta property="og:video:width" content={String(videoWidth)} />}
{video && videoHeight && <meta property="og:video:height" content={String(videoHeight)} />}
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.xHandle} />
<meta name="twitter:creator" content={SITE.xHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{jsonLd.length > 0 && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
