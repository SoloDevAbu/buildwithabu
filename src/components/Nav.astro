---
import { NAV, SITE } from "@/lib/site"
---

<header class="nav">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label={`${SITE.product} home`}>
      <span class="mark" aria-hidden="true"></span>
      <span>abu reel <em class="em">kit</em></span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn--sm" href="/pricing">Get it · {SITE.priceLabel}</a>
    <details class="menu">
      <summary aria-label="Open menu"><span></span><span></span></summary>
      <div class="sheet" data-dither="sm">
        {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/pricing">Pricing</a>
      </div>
    </details>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    pointer-events: none;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-block: 14px;
  }
  .bar > * {
    pointer-events: auto;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-right: auto;
    padding: 6px 12px 7px 9px;
    background: var(--white);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.03em;
    text-decoration: none;
    line-height: 1.2;
  }
  .logo .em {
    color: #cf4114;
    font-size: 1.15em;
  }
  .mark {
    width: 13px;
    height: 22px;
    border: 2px solid var(--ink);
    border-radius: 3px;
    background: linear-gradient(var(--coral) 0 0) 0 100% / 100% 62% no-repeat;
  }
  nav ul {
    display: flex;
    gap: 2px;
    padding: 3px;
    background: var(--white);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 10px;
  }
  nav a {
    display: block;
    padding: 5px 11px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: none;
  }
  nav a:hover {
    background: var(--paper);
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    display: grid;
    place-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: var(--white);
    border: 2px solid var(--ink);
    border-radius: 10px;
    list-style: none;
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    width: 16px;
    height: 2px;
    background: var(--ink);
  }
  .menu .sheet {
    position: absolute;
    right: 0;
    top: 50px;
    display: grid;
    width: 200px;
    padding: 8px;
    border-radius: 12px;
  }
  .menu .sheet a {
    padding: 10px;
    text-decoration: none;
    font-weight: 500;
  }
  @media (max-width: 820px) {
    nav {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
