---
import { SITE } from "@/lib/site"

const year = new Date().getFullYear()
const columns = [
  {
    title: "product",
    links: [
      ["/how-it-works", "How it works"],
      ["/reels", "Reels"],
      ["/pricing", "Pricing"],
      ["/faq", "FAQ"],
      ["/changelog", "Changelog"],
    ],
  },
  {
    title: "learn",
    links: [
      ["/guides", "Guides"],
      ["/compare", "Compare"],
      ["/about", "About"],
      ["/contact", "Contact"],
    ],
  },
  {
    title: "legal",
    links: [
      ["/legal/terms", "Terms"],
      ["/legal/refunds", "Refund policy"],
      ["/legal/license", "Licence"],
      ["/legal/privacy", "Privacy"],
      ["/legal/cookies", "Cookies"],
    ],
  },
]
---

<footer>
  <div class="tape" aria-hidden="true"></div>
  <div class="foot">
    <div class="wrap">
      <p class="end">final/<span class="em">your-reel</span>.mp4</p>
      <div class="cols">
        <div class="who">
          <p>
            {SITE.product} is made by {SITE.seller} in {SITE.sellerCountry}, under the {SITE.brand} name.
          </p>
          <p class="links">
            <a class="link" href={SITE.instagram} rel="me noopener">{SITE.instagramHandle}</a>
            <a class="link" href={SITE.x} rel="me noopener">{SITE.xHandle}</a>
            <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </div>
        {
          columns.map((col) => (
            <nav aria-label={col.title}>
              <p class="kicker">// {col.title}</p>
              <ul>
                {col.links.map(([href, label]) => (
                  <li>
                    <a href={href}>{label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
      <p class="mor">
        Orders are processed by <a class="link" href="https://dodopayments.com" rel="noopener">Dodo Payments</a>, our
        Merchant of Record and authorised reseller, who also handles sales tax and VAT and appears on your statement.
        © {year}
        {SITE.seller}. Not affiliated with Instagram, TikTok, YouTube, Remotion or Anthropic.
      </p>
    </div>
  </div>
</footer>

<style>
  .foot {
    --fg: #efefe7;
    --muted: #b1b3a9;
    --accent: #f6784f;
    background: var(--ink-soft);
    color: var(--fg);
    padding-block: clamp(48px, 7vw, 90px) 110px;
  }
  .end {
    font-weight: 500;
    font-size: clamp(2.1rem, 9.4vw, 8.6rem);
    line-height: 1;
    letter-spacing: -0.05em;
    overflow-wrap: anywhere;
  }
  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 32px;
    margin-top: clamp(40px, 6vw, 72px);
  }
  .who p {
    max-width: 38ch;
    color: var(--muted);
  }
  .links {
    display: grid;
    justify-items: start;
    gap: 4px;
    margin-top: 14px;
  }
  .links a {
    color: var(--fg);
  }
  ul {
    display: grid;
    gap: 7px;
    margin-top: 12px;
  }
  li a {
    text-decoration: none;
  }
  li a:hover {
    color: var(--accent);
  }
  .mor {
    margin-top: 52px;
    padding-top: 18px;
    border-top: 1px solid rgb(239 239 231 / 0.2);
    font-size: 0.82rem;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .who {
      grid-column: 1 / -1;
    }
  }
</style>
