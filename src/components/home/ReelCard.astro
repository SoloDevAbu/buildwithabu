---
import { formatDuration, type Reel } from "@/lib/reels"

type Props = { reel: Reel; eager?: boolean }
const { reel, eager = false } = Astro.props
---

<a class="reel" href={`/reels/${reel.slug}`} data-teaser={reel.teaser} aria-label={`Watch reel: ${reel.title} (${formatDuration(reel.duration_seconds)})`}>
  <img src={reel.poster} alt={`${reel.title}, vertical reel made with Abu Reel Kit`} width={reel.width} height={reel.height} loading={eager ? "eager" : "lazy"} decoding="async" />
  <span class="zones" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="play-badge" aria-hidden="true"></span>
  <span class="time mono" aria-hidden="true">{formatDuration(reel.duration_seconds)}</span>
  <span class="title">{reel.title}</span>
</a>

<style>
  .reel {
    position: relative;
    display: block;
    flex: none;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 16px;
    background: var(--ink);
    color: #fff;
    text-decoration: none;
    transition: translate 0.16s var(--spring);
  }
  .reel:hover {
    translate: 0 -3px;
  }
  .reel :global(video),
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play-badge {
    position: absolute;
    top: 9px;
    left: 9px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgb(18 19 22 / 0.78);
    border: 1.5px solid rgb(255 255 255 / 0.35);
    transition: opacity 0.15s ease;
  }
  .play-badge::after {
    content: "";
    position: absolute;
    inset: 7px 6px 7px 9px;
    background: #fff;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .reel:has(video) .play-badge {
    opacity: 0;
  }
  .time {
    position: absolute;
    top: 9px;
    right: 9px;
    padding: 2px 7px;
    border-radius: 6px;
    background: var(--ink);
    color: #fff;
    font-size: 0.7rem;
  }
  .title {
    position: absolute;
    inset: auto 0 0;
    padding: 34px 12px 11px;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.78));
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .zones {
    display: none;
  }
  :global(html[data-zones]) .zones {
    display: block;
  }
  .zones i {
    position: absolute;
    background: rgb(239 68 68 / 0.32);
    outline: 1px dashed var(--red);
    outline-offset: -1px;
  }
  .zones i:nth-child(1) {
    inset: 0 0 auto;
    height: 11.5%;
  }
  .zones i:nth-child(2) {
    inset: auto 0 0;
    height: 19.8%;
  }
  .zones i:nth-child(3) {
    top: 11.5%;
    bottom: 19.8%;
    right: 0;
    width: 11.1%;
  }
</style>
