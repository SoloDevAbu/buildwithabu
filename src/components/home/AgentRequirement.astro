---
const MAIN = [
  { name: "Claude Code", logo: "claudecode", recommended: true },
  { name: "Codex", logo: "codex" },
  { name: "Cursor", logo: "cursor" },
  { name: "Antigravity", logo: "antigravity" },
]
const OTHERS = [
  { name: "OpenCode", logo: "opencode" },
  { name: "Gemini CLI", logo: "geminicli" },
  { name: "GitHub Copilot", logo: "githubcopilot" },
  { name: "Windsurf", logo: "windsurf" },
  { name: "Cline", logo: "cline" },
  { name: "Roo Code", logo: "roocode" },
  { name: "Kilo Code", logo: "kilocode" },
  { name: "Amp", logo: "amp" },
]
---

<div class="agents">
  <p class="lede">You need at least one AI coding agent to use the kit. It runs inside your agent, so the agent isn't included, and any plan or usage cost is separate.</p>
  <ul class="apps">
    {
      MAIN.map((agent) => (
        <li>
          <span class:list={["icon", { pick: agent.recommended }]}>
            <img src={`/img/agents/${agent.logo}.svg`} alt="" width="52" height="52" loading="lazy" />
          </span>
          <b>{agent.name}</b>
          {agent.recommended && <span class="mono rec">recommended</span>}
        </li>
      ))
    }
  </ul>
  <p class="note"><b>Claude Code is recommended</b> for the highest quality output.</p>
  <div class="others">
    <p class="kicker">// or use any other coding agent</p>
    <ul>
      {
        OTHERS.map((agent) => (
          <li>
            <img src={`/img/agents/${agent.logo}.svg`} alt="" width="18" height="18" loading="lazy" />
            {agent.name}
          </li>
        ))
      }
      <li>and more</li>
    </ul>
  </div>
</div>

<style>
  .agents {
    display: grid;
    gap: 24px;
  }
  .apps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 132px));
    gap: 20px clamp(16px, 4vw, 44px);
    margin-top: 6px;
  }
  .apps li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 9px;
    text-align: center;
  }
  /* Rounded like a home-screen app icon. The tile stays white so every logo keeps its own colours. */
  .icon {
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    border: 2px solid var(--ink);
    border-radius: 22px;
    background: #fff;
  }
  .icon.pick {
    outline: 3px solid var(--yellow);
    outline-offset: 2px;
  }
  .icon img {
    width: 52px;
    height: 52px;
  }
  .apps b {
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .rec {
    font-size: 0.72rem;
    color: var(--muted);
  }
  .note b {
    font-weight: 600;
  }
  .others {
    display: grid;
    gap: 12px;
    padding-top: 22px;
    border-top: 2px solid var(--rule);
  }
  .others ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .others li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 11px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-size: 0.88rem;
  }
  @media (max-width: 560px) {
    .apps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
