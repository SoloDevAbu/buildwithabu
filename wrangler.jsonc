{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buildwithabu",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  "vars": {
    // Flip to "live_mode" (and swap the product id + secrets) when Dodo approves the account.
    "DODO_ENVIRONMENT": "test_mode",
    "DODO_PRODUCT_ID": "pdt_REPLACE_ME",
    "PUBLIC_MEDIA_URL": "https://media.buildwithabu.xyz"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buildwithabu",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "KIT", "bucket_name": "reel-kit-private" },
    { "binding": "REELS", "bucket_name": "reels-public" }
  ],
  "ratelimits": [
    { "name": "CHECKOUT_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
